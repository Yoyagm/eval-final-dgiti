# =========================
# Configuración de la app
# =========================
APP_NAME=eval-final-dgiti
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# =========================
# Base de datos
# Local (docker-compose): postgresql+asyncpg://postgres:postgres@db:5432/items
# RDS (producción): postgresql+asyncpg://USER:PASSWORD@RDS_ENDPOINT:5432/items
# =========================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/items
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# =========================
# CORS (lista separada por comas o array JSON)
# =========================
CORS_ORIGINS=["*"]
